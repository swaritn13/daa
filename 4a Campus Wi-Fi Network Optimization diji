#include <iostream>
#include <vector>
#include <queue>
#include <climits>
#include <utility>

using namespace std;

typedef pair<int, int> PII;
// PII = {distance, node}

void dijkstra(int source,
              const vector<vector<PII>>& graph,
              vector<int>& distance,
              vector<int>& parent) {

    int n = graph.size();

    distance.assign(n, INT_MAX);
    parent.assign(n, -1);

    // Min-priority queue
    priority_queue<PII,
                   vector<PII>,
                   greater<PII>> pq;

    distance[source] = 0;
    pq.push({0, source});

    while (!pq.empty()) {

        int currentDistance = pq.top().first;
        int currentNode = pq.top().second;

        pq.pop();

        // Ignore outdated entry
        if (currentDistance > distance[currentNode])
            continue;

        // Check all connected nodes
        for (auto edge : graph[currentNode]) {

            int nextNode = edge.first;
            int weight = edge.second;

            if (distance[currentNode] + weight <
                distance[nextNode]) {

                distance[nextNode] =
                    distance[currentNode] + weight;

                parent[nextNode] = currentNode;

                pq.push({
                    distance[nextNode],
                    nextNode
                });
            }
        }
    }
}

// Print shortest path
void printPath(int node,
               const vector<int>& parent) {

    if (node == -1)
        return;

    printPath(parent[node], parent);

    cout << node << " ";
}

int main() {

    int n, m;

    cout << "Enter number of routers/access points: ";
    cin >> n;

    cout << "Enter number of network connections: ";
    cin >> m;

    vector<vector<PII>> graph(n);

    cout << "\nEnter connections:\n";
    cout << "Format: Source Destination Latency\n";

    for (int i = 0; i < m; i++) {

        int u, v, latency;

        cin >> u >> v >> latency;

        // Undirected network
        graph[u].push_back({v, latency});
        graph[v].push_back({u, latency});
    }

    int source;

    cout << "\nEnter source server (S): ";
    cin >> source;

    vector<int> distance;
    vector<int> parent;

    // Apply Dijkstra
    dijkstra(source, graph, distance, parent);

    cout << "\n===== Minimum Latency Paths =====\n";

    for (int i = 0; i < n; i++) {

        cout << "\nDestination: " << i;

        if (distance[i] == INT_MAX) {

            cout << "\nNo path available.";

        }
        else {

            cout << "\nMinimum Latency: "
                 << distance[i]
                 << " ms";

            cout << "\nOptimal Route: ";

            printPath(i, parent);

            cout << endl;
        }
    }

    return 0;
}
